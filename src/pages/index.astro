---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatRupiah, waLink } from '../lib/format';

const site = (await getEntry('site', 'site'))!.data;
const menu = (await getCollection('menu', (e) => e.data.aktif))
  .sort((a, b) => a.data.urutan - b.data.urutan)
  .slice(0, 3);
const galeri = (await getCollection('galeri')).sort((a, b) => a.data.urutan - b.data.urutan);
const perks = [
  { title: 'Harga Ramah', text: 'Menu sehari-hari dengan harga yang pas di kantong.' },
  { title: 'Suasana Hangat', text: 'Tempat nongkrong santai buat ngobrol, kerja, atau sekadar istirahat.' },
  { title: 'Buka Tiap Hari', text: site.jam_buka },
];
const tagline = `${site.tagline}. Mampir ke ${site.nama} di ${site.alamat}.`;
---

<Base
  title={`${site.nama} — ${site.tagline}`}
  description={`${site.nama}: ${site.tagline}. Menu kopi dan makanan khas, alamat ${site.alamat}. Buka ${site.jam_buka}.`}
>
	<section class="hero">
		<div class="container hero-grid">
			<div>
				<span class="eyebrow hero-eyebrow">Warkop • Ngopi Santai</span>
				<h1 class="display hero-title" data-split data-hero>Ngopi santai, ngobrol asik.</h1>
				<p class="lead hero-lead">{tagline}</p>
				<div class="hero-cta">
					<a href="/menu/" class="btn btn-primary" data-magnetic>Lihat Menu</a>
					<a href={waLink(site.whatsapp)} class="btn btn-ghost" target="_blank" rel="noopener noreferrer" data-magnetic>Pesan via WhatsApp</a>
				</div>
			</div>
			<div class="hero-logo">
				<img src="/images/logo.jpg" alt={`Logo ${site.nama}`} width="420" height="420" fetchpriority="high" />
			</div>
		</div>
	</section>

	<div class="marquee" aria-hidden="true">
		<div class="marquee-track">
			<span>Kopi Susu</span><span>Indomie Jumbo</span><span>Nongkrong</span><span>Ngobrol</span>
			<span>Kopi Susu</span><span>Indomie Jumbo</span><span>Nongkrong</span><span>Ngobrol</span>
		</div>
	</div>

	<section>
		<div class="container">
			<span class="num num-center reveal">01 — MENU</span>
			<h2 class="section-title display-2" data-split>Favorit pengunjung</h2>
			<p class="section-sub reveal" style="--d:120ms">Sebagian menu yang paling sering dipesan. Lihat semua menu di halaman Menu.</p>
			<div class="grid">
				{menu.map((item, i) => (
					<article class="card reveal" style={`--d:${i * 120}ms`} data-tilt>
						<div class="card-media">
							<img src={item.data.gambar} alt={item.data.nama} loading="lazy" width="400" height="300" />
							<span class="badge">{item.data.kategori}</span>
						</div>
						<div class="card-body">
							<h3>{item.data.nama}</h3>
							<p class="price">{formatRupiah(item.data.harga)}</p>
						</div>
					</article>
				))}
			</div>
			<div class="reveal" style="text-align:center;margin-top:44px">
				<a href="/menu/" class="btn btn-ghost" data-magnetic>Lihat Semua Menu</a>
			</div>
		</div>
	</section>

	<section style="background:var(--red-soft)">
		<div class="container about-grid">
			<div>
				<span class="num reveal">02 — TENTANG</span>
				<h2 class="section-title" data-split style="text-align:left">Tempat ngopi yang bikin betah</h2>
				<p class="section-sub" style="text-align:left;margin-left:0" data-scrub-text>
					{site.nama} hadir buat jadi tempat nongkrong yang santai. Enak buat ngopi sore, ngobrol bareng teman, atau sekadar istirahat sebentar.
				</p>
				<ul class="info-list reveal" style="margin-top:24px">
					{perks.map((p, i) => (
						<li style={`--d:${i * 120}ms`} class="reveal" data-tilt>
							<strong>{p.title}</strong>
							{p.text}
						</li>
					))}
				</ul>
			</div>
			<div class="par reveal" style="--d:150ms;aspect-ratio:4/5">
				<img data-parallax="10" src="/images/kopi-hitam-susu.jpg" alt="Kopi hitam susu khas Warkop Rahayoe" loading="lazy" width="640" height="800" />
				<div class="about-chip">Kopi & ngobrol ✦</div>
			</div>
		</div>
	</section>

	<section id="galeri">
		<div class="container">
			<span class="num num-center reveal">03 — GALERI</span>
			<h2 class="section-title" data-split>Suasana warkop</h2>
			<div class="bento" style="margin-top:36px">
				{galeri.map((g, i) => (
					<figure class={`reveal ${g.data.ukuran}`} style={`--d:${i * 120}ms`}>
						<img src={g.data.src} alt={g.data.alt} loading="lazy" width="600" height="400" />
					</figure>
				))}
			</div>
		</div>
	</section>

	<section style="padding-top:0">
		<div class="container">
			<div class="cta-band reveal">
				<h2 data-split>Mampir sekarang, kopinya siap.</h2>
				<p>{site.alamat} · {site.jam_buka}</p>
				<div class="hero-cta" style="justify-content:center">
					<a href={waLink(site.whatsapp)} class="btn btn-primary" target="_blank" rel="noopener noreferrer" data-magnetic>Chat WhatsApp</a>
					<a href={site.google_maps} class="btn btn-ghost" style="border-color:#fff;color:#fff" target="_blank" rel="noopener noreferrer" data-magnetic>Buka Google Maps</a>
				</div>
			</div>
		</div>
	</section>
</Base>
