---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { waLink } from '../lib/format';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/logo.jpg' } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/menu/', label: 'Menu' },
  { href: '/tentang/', label: 'Tentang' },
  { href: '/#galeri', label: 'Galeri' },
  { href: '/kontak/', label: 'Kontak' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: site.nama,
  description: site.tagline,
  image: imageUrl.toString(),
  url: Astro.site?.toString(),
  telephone: `+${site.whatsapp}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.alamat,
    addressCountry: 'ID',
  },
  openingHours: 'Mo-Su 08:00-22:00',
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
		<meta name="theme-color" content="#c8102e" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.nama} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Rubik:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<header class="navbar">
			<div class="container navbar-inner">
				<a href="/" class="brand">{site.nama}</a>
				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="site-nav"
					aria-label="Buka menu"
				>
					<span></span><span></span><span></span>
				</button>
				<ul class="nav-links" id="site-nav">
					{navLinks.map((link) => (
						<li>
							<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</header>

		<div class="progress" aria-hidden="true"></div>
		<div class="cursor" aria-hidden="true"></div>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="container">
				<a href="/" class="brand">{site.nama}</a>
				<p>{site.alamat}</p>
				<p>Buka: {site.jam_buka}</p>
			</div>
		</footer>

		<a
			class="wa-float"
			href={waLink(site.whatsapp)}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Chat WhatsApp" data-magnetic
		>
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.14c-.25.7-1.45 1.34-2 1.4-.52.06-1.19.09-1.91-.12-.44-.14-1-.32-1.73-.63-3.04-1.31-5.02-4.38-5.17-4.58-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.52.28-.3.61-.37.81-.37.2 0 .4 0 .58.01.19.01.44-.07.69.53.25.6.85 2.08.93 2.23.08.15.13.33.03.53-.1.2-.15.32-.3.5-.15.17-.31.39-.45.52-.15.15-.3.31-.13.6.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.13.65-.08.17-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.27.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.42z"
				/>
			</svg>
		</a>

		<script>
			import '../scripts/motion';

			const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const nav = document.getElementById('site-nav');
			const setOpen = (open: boolean) => {
				toggle?.setAttribute('aria-expanded', String(open));
				toggle?.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
				nav?.classList.toggle('open', open);
			};
			toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
			nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') setOpen(false);
			});

		</script>
	</body>
</html>
